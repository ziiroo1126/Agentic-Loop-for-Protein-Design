{
  "schema_version": "0.1",
  "name": "mock_ligand_binder",
  "description": "Design a short protein against a ligand supplied as SMILES.",
  "model": "odesign_base_prot_flex",
  "design_modality": "protein",
  "molecules": [
    {
      "id": "ligand",
      "type": "ligand",
      "role": "context",
      "smiles": "CC(=O)OC1=CC=CC=C1C(=O)O"
    },
    {
      "id": "binder",
      "type": "protein",
      "role": "design",
      "segments": [
        {
          "kind": "generated",
          "min_length": 30,
          "max_length": 40
        }
      ]
    }
  ],
  "generation": {
    "seeds": [7, 19],
    "samples_per_seed": 2,
    "inverse_fold_topk": 1,
    "inverse_fold_temperature": 1.0,
    "inverse_fold_beam": true,
    "use_msa": false,
    "num_workers": 1,
    "partial_diffusion_snr": 0.1
  },
  "evaluation": {
    "binder_molecule": "binder"
  }
}
